generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                GroupMember[]
  paidBy                     Transaction[]       @relation("PaidBy")
  debtShares                 DebtShare[]
  auditLogs                  AuditLog[]
  sessions                   Session[]
  sentSettlementPayments     SettlementPayment[] @relation("SettlementPaymentFrom")
  receivedSettlementPayments SettlementPayment[] @relation("SettlementPaymentTo")

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum TransactionStatus {
  COMPLETED
  PENDING
  REJECTED
}

enum GroupRole {
  ADMIN
  MEMBER
  AUDITOR
}

enum SettlementPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum AuditAction {
  GROUP_CREATED
  GROUP_DELETED
  GROUP_UPDATED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_LEFT
  ROLE_CHANGED
  EXPENSE_ADDED
  EXPENSE_DELETED
  EXPENSE_UPDATED
  SETTLEMENT_COMPLETED
  SETTLEMENT_SENT
  SETTLEMENT_CONFIRMED
  SETTLEMENT_REJECTED
  SETTLEMENT_CANCELLED
  EXPORT_CSV
  EXPORT_PDF
  EXPORT_EMAIL
  USER_LOGIN
  USER_REGISTER
  USER_LOGOUT
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members            GroupMember[]
  transactions       Transaction[]
  auditLogs          AuditLog[]
  settlementPayments SettlementPayment[]

  @@map("groups")
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_members")
}

model Transaction {
  id               String            @id @default(cuid())
  groupId          String
  paidById         String
  amount           Decimal           @db.Decimal(19, 4)
  originalCurrency String?
  exchangeRate     Decimal?          @db.Decimal(20, 10)
  description      String
  status           TransactionStatus @default(COMPLETED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  group      Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy     User        @relation("PaidBy", fields: [paidById], references: [id])
  debtShares DebtShare[]

  @@index([groupId])
  @@index([paidById])
  @@map("transactions")
}

model DebtShare {
  id            String  @id @default(cuid())
  transactionId String
  owedById      String
  amount        Decimal @db.Decimal(19, 4)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  owedBy      User        @relation(fields: [owedById], references: [id])

  @@index([transactionId])
  @@index([owedById])
  @@map("debt_shares")
}

model SettlementPayment {
  id           String                  @id @default(cuid())
  groupId      String
  fromUserId   String
  toUserId     String
  amount       Decimal                 @db.Decimal(19, 4)
  currency     String
  status       SettlementPaymentStatus @default(PENDING)
  note         String?
  decisionNote String?
  createdAt    DateTime                @default(now())
  decidedAt    DateTime?

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementPaymentFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementPaymentTo", fields: [toUserId], references: [id])

  @@index([groupId, createdAt])
  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@map("settlement_payments")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  groupId   String?
  action    AuditAction
  details   String?
  metadata  Json?
  createdAt DateTime    @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
