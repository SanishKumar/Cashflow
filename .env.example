# Database (Neon — serverless PostgreSQL)
# Sign up at https://neon.tech — free tier
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require"

# Redis (Upstash — serverless Redis with TLS)
# Sign up at https://upstash.com — free tier
# IMPORTANT: Use rediss:// (double-s) for TLS connections
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379"

# Server
PORT=4000
NODE_ENV=development

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-at-least-32-characters-long-change-this-in-production"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Receipt scanning (server-side OCR.space Engine 3)
# Get a free key from https://ocr.space/ocrapi. Keep this server-side only.
OCR_SPACE_API_KEY=""
# Comma-separated user IDs receive unlimited scans; other authenticated users receive 20/hour.
PREMIUM_RECEIPT_USER_IDS=""
